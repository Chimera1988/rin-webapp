{
  "name": "rin-webapp",
  "private": true,
  "type": "module",
  "scripts": {
    "syntax": "node scripts/check-syntax.js",
    "validate": "node scripts/validate-json.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build": "node scripts/build-smoke.js",
    "check": "npm run check:node && npm run e2e:browser",
    "e2e:browser": "node scripts/browser-e2e.js",
    "check:node": "npm run syntax && npm run validate && npm test && npm run build"
  },
  "dependencies": {
    "@upstash/redis": "^1.36.0",
    "web-push": "^3.6.7",
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/blob": "^2.3.0"
  }
}
